  "item": [
    {
      "name": "1. Add Beneficiary - Success Scenario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": 1,\n  \"beneficiaryName\": \"Alice Brown\",\n  \"beneficiaryAccountNumber\": \"BENE001\",\n  \"confirmAccountNumber\": \"BENE001\",\n  \"ifscCode\": \"YESB00088\",\n  \"nickname\": \"Alice\"\n}"
        },
        "url": {
          "raw": "http://localhost:8081/api/beneficiary/add",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8081",
          "path": [
            "api",
            "beneficiary",
            "add"
          ]
        },
        "description": "Add a new beneficiary for customer with ACTIVE account. Beneficiary will be PENDING_ACTIVATION initially and become ACTIVE after 1 minute."
      }
    },
